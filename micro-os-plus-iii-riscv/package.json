{
  "name": "@micro-os-plus/micro-os-plus-iii-riscv",
  "version": "0.1.0",
  "description": "A source code library with the µOS++ RISC-V port (RV64GC, machine mode; first board Milk-V Duo)",
  "main": "",
  "scripts": {
    "npm-install": "npm install",
    "pack": "npm pack",
    "version-patch": "npm version patch",
    "version-minor": "npm version minor",
    "postversion": "git push origin --all && git push origin --tags",
    "git-log": "git log --pretty='%cd * %h %s' --date=short"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/micro-os-plus/micro-os-plus-iii-riscv.git"
  },
  "homepage": "https://github.com/micro-os-plus/micro-os-plus-iii-riscv",
  "bugs": {
    "url": "https://github.com/micro-os-plus/micro-os-plus-iii-riscv/issues"
  },
  "keywords": [
    "xpack",
    "riscv",
    "rv64",
    "µOS++",
    "micro-os-plus",
    "milk-v",
    "cv1800b",
    "c906"
  ],
  "author": {
    "name": "Liviu Ionescu",
    "email": "ilg@livius.net",
    "url": "https://github.com/ilg-ul"
  },
  "license": "MIT",
  "config": {},
  "dependencies": {},
  "devDependencies": {},
  "xpack": {
    "minimumXpmRequired": "0.16.2",
    "dependencies": {},
    "$dependenciesUrls": [
      "https://github.com/micro-os-plus",
      "https://github.com/xpacks",
      "https://github.com/xpack-dev-tools"
    ],
    "devDependencies": {
      "@xpack-dev-tools/riscv-none-elf-gcc": "15.2.0-1.1",
      "@xpack-dev-tools/qemu-riscv": "9.2.4-1.1",
      "@xpack-dev-tools/openocd": "0.12.0-7.1",
      "@xpack-dev-tools/cmake": "3.26.5-1.1",
      "@xpack-dev-tools/ninja-build": "1.11.1-3.1"
    },
    "properties": {
      "buildFolderRelativePath": "test/build",
      "commandPrepare": "cmake -S . -B {{ properties.buildFolderRelativePath }} -G Ninja -D CMAKE_TOOLCHAIN_FILE=cmake/toolchains/riscv-none-elf.cmake -D CMAKE_BUILD_TYPE=Debug -D BOARD=milkv-duo -D CMAKE_EXPORT_COMPILE_COMMANDS=ON"
    },
    "actions": {
      "install": [
        "npm install",
        "xpm install"
      ],
      "prepare": "{{ properties.commandPrepare }}",
      "build": [
        "{{ properties.commandPrepare }}",
        "cmake --build {{ properties.buildFolderRelativePath }}"
      ],
      "test": "cd {{ properties.buildFolderRelativePath }} && ctest -V -LE hwd",
      "clean": "cmake --build {{ properties.buildFolderRelativePath }} --target clean",
      "test-hwd": "bash test/hw-all.sh",
      "hw-reset": "bash test/boards/milkv-duo/hw-reset.sh"
    },
    "buildConfigurations": {}
  }
}
