# Build trees
# build*/ , not build/ + build-*/ : a directory named build15 or
# buildgcc14 slipped through the narrower pair and got committed once.
build*/
test/build*/
cmake-build*/
test/build*/
output/
target/

# Objects and images
*.o
*.obj
*.d
*.a
*.elf
*.hex
*.bin
*.lst
*.map
*.su

# Test-run scratch
.hw-run*
.hw-jlink-run*
.qemu-verify/
**/disk*.img
# The USB file tests' copy written back by the PC (usb-file-host.py)
**/name.dat.back
__pycache__/

# Editors / OS
*.swp
*~
.vscode/
.idea/
.DS_Store
